# List local recipes. Modal recipes live in modal/justfile.
default:
    @just --list

# Install the Apple Silicon runtime in .venv-local.
setup:
    bash scripts/setup-local.sh

# Start the local MLX server and print request logs.
serve port="8000":
    @test -x .venv-local/bin/python || { echo "Run just setup first."; exit 1; }
    .venv-local/bin/python playground.py --port {{quote(port)}}

# Send a chat request to the local server.
chat prompt="Explain the KV cache in simple terms." port="8000":
    python3 chat.py --prompt {{quote(prompt)}} --port {{quote(port)}}

# Send N simultaneous local requests; watch running-req in server logs.
chat-concurrent n="4" prompt="Explain prefix caching in detail." port="8000" max_tokens="256":
    python3 chat.py --concurrent {{quote(n)}} --prompt {{quote(prompt)}} --port {{quote(port)}} --max-tokens {{quote(max_tokens)}}

# Check local server readiness.
health port="8000":
    curl --silent --show-error --fail-with-body --connect-timeout 5 --max-time 10 {{quote("http://127.0.0.1:" + port + "/health")}}

# Check local Python syntax without loading the model.
check:
    python3 -c 'from pathlib import Path; [compile(Path(p).read_text(), p, "exec") for p in ("playground.py", "chat.py")]; print("Syntax OK")'

# Compatibility aliases for the earlier local recipes.
alias setup-local := setup
alias serve-local := serve
alias chat-local := chat
alias health-local := health
