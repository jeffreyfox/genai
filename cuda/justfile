# Show available commands.
default:
    @just --list

# Install local dependencies using the lockfile.
setup:
    uv sync --locked

# Authenticate your machine with Modal (one-time setup).
auth:
    uv run modal setup

# Compile the bench with nvcc on Modal and run the chosen kernel on a GPU.
# gpu is a Modal GPU name, for example T4, A10, L40S, or A100-40GB.
# Positional: just run mat_mul        → T4
#             just run mat_mul L40S   → L40S
run kernel="vec_add" gpu="T4":
    uv run modal run modal_run.py --gpu {{gpu}} --kernel {{kernel}}

# Sweep input length n; each run prints time and effective bandwidth.
sweep-n kernel="vec_add" gpu="T4":
    uv run modal run modal_run.py --sweep-n --gpu {{gpu}} --kernel {{kernel}}

