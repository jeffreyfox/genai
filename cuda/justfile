# Show available commands.
default:
    @just --list

# Install local dependencies using the lockfile.
setup:
    uv sync --locked

# Authenticate your machine with Modal (one-time setup).
auth:
    uv run modal setup

# Run vector add with verification: just run-vecadd 1048576 L40S
run-vecadd n="1048576" gpu="T4":
    uv run modal run modal_run.py --gpu {{gpu}} --kernel vec_add --n {{n}}

# Run matmul with verification: just run-matmul 4096 T4 true 16
run-matmul n="256" gpu="T4" tiled="false" tile_width="32":
    @case "{{tiled}}" in true|false) ;; *) echo "tiled must be true or false" >&2; exit 1 ;; esac
    uv run modal run modal_run.py --kernel mat_mul --n {{n}} --gpu {{gpu}} {{if tiled == "true" { "--tiled --tile-width " + tile_width } else { "" }}}

# Sweep vector lengths without CPU verification.
sweep-vecadd gpu="T4":
    uv run modal run modal_run.py --sweep n --gpu {{gpu}} --kernel vec_add

# Sweep matrix width (n) or tile width (tile), without CPU verification.
# just sweep-matmul n 256,512,1024 T4 true 4096 16
# just sweep-matmul tile 4,8,16,32 T4 true 4096
# Use "" for values to select the default sweep list.
sweep-matmul axis="n" values="" gpu="T4" tiled="false" n="4096" tile_width="32":
    @case "{{tiled}}" in true|false) ;; *) echo "tiled must be true or false" >&2; exit 1 ;; esac
    uv run modal run modal_run.py --kernel mat_mul --sweep {{axis}} --values '{{values}}' --gpu {{gpu}} --n {{n}} {{if tiled == "true" { "--tiled --tile-width " + tile_width } else { "" }}}
