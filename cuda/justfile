# Show available commands.
default:
    @just --list

# Install local dependencies using the lockfile.
setup:
    uv sync --locked

# Authenticate your machine with Modal (one-time setup).
auth:
    uv run modal setup

# Compile the bench with nvcc on Modal and run the chosen kernel on a GPU.
# gpu is a Modal GPU name, for example T4, A10, L40S, or A100-40GB.
# Positional: just run mat_mul        → T4
#             just run mat_mul L40S   → L40S
run kernel="vec_add" gpu="T4":
    uv run modal run modal_run.py --gpu {{gpu}} --kernel {{kernel}}

# Sweep input length n; each run prints time and effective bandwidth.
sweep-n kernel="vec_add" gpu="T4":
    uv run modal run modal_run.py --sweep-n --gpu {{gpu}} --kernel {{kernel}}

# Run tiled matmul with verification: just run-tiled L40S 16
run-tiled gpu="T4" tile_width="32":
    uv run modal run modal_run.py --kernel mat_mul --gpu {{gpu}} --tiled --tile-width {{tile_width}}

# Sweep matrix widths with tiled matmul, without CPU verification.
sweep-n-tiled gpu="T4" tile_width="32":
    uv run modal run modal_run.py --sweep-n --kernel mat_mul --gpu {{gpu}} --tiled --tile-width {{tile_width}}


# Sweep 4x4, 8x8, 16x16, 32x32 tiles at a fixed matrix width; no CPU verification.
sweep-tile n="4096" gpu="T4":
    uv run modal run modal_run.py --kernel mat_mul --sweep-tile --n {{n}} --gpu {{gpu}}
